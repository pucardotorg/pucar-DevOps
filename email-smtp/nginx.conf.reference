# nginx.conf.reference — VM nginx configuration for the emailsmtp.pucar.org stack
#
# This is a REFERENCE file showing the required changes to /etc/nginx/nginx.conf
# on the host VM. It is NOT copied automatically — apply manually as described
# in the README (Step 2).
#
# The VM nginx serves two purposes:
#   1. HTTP (port 80)  — ACME challenge forwarding + HTTPS redirect (sites-enabled)
#   2. TCP stream      — raw passthrough for HTTPS (443) and SMTP (25/465/587)
#
# Architecture:
#   Browser :443   → nginx stream (TLS passthrough) → Caddy :10443 (terminates TLS)
#   Client  :587   → nginx stream (TCP passthrough) → mailserver :10587 (STARTTLS)
#   Client  :25    → nginx stream (TCP passthrough) → mailserver :10025
#   Client  :465   → nginx stream (TCP passthrough) → mailserver :10465 (implicit TLS)
#
# Docker port bindings (email-smtp/docker-compose.yaml):
#   127.0.0.1:10025:25   — SMTP
#   127.0.0.1:10465:465  — SMTPS
#   127.0.0.1:10587:587  — Submission
# nginx owns the standard external ports; Docker binds to localhost offset ports only.

user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

# ----------------------------------------------------------------
# Stream block — raw TCP passthrough (TLS and SMTP)
# ----------------------------------------------------------------
stream {
    # HTTPS — TLS passthrough to Caddy (Caddy is the sole TLS authority)
    upstream caddy_gateway_https {
        server 127.0.0.1:10443;
    }

    map $ssl_preread_server_name $upstream {
        default caddy_gateway_https;
    }

    server {
        listen 443;
        proxy_pass $upstream;
        ssl_preread on;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
    }

    # SMTP — raw TCP passthrough to mailserver (Docker binds to localhost offset ports)
    server {
        listen 25;
        proxy_pass 127.0.0.1:10025;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
    }

    server {
        listen 465;
        proxy_pass 127.0.0.1:10465;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
    }

    server {
        listen 587;
        proxy_pass 127.0.0.1:10587;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
    }
}

# ----------------------------------------------------------------
# HTTP block — ACME challenges and domain redirects (port 80)
# ----------------------------------------------------------------
http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    gzip on;

    # Virtual host configs (including nginx-emailsmtp.conf installed in sites-enabled)
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}

# ================================================================
# sites-enabled: /etc/nginx/sites-enabled/emailsmtp.pucar.org
# ================================================================
# Install from repo:
#   sudo cp nginx-emailsmtp.conf /etc/nginx/sites-enabled/emailsmtp.pucar.org
#   sudo nginx -t && sudo systemctl reload nginx
#
# This file lives in the http {} block — handles port 80 only.
# Port 443 is handled above in the stream {} block (TLS passthrough to Caddy).
# SMTP ports 25/465/587 are handled above in the stream {} block (passthrough to mailserver).
# ================================================================

# server {
#     listen 80;
#     listen [::]:80;
#     server_name emailsmtp.pucar.org;
#
#     # Forward ACME challenge to Caddy so it can obtain/renew the TLS cert.
#     location /.well-known/acme-challenge/ {
#         proxy_pass http://127.0.0.1:10080;
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#     }
#
#     # Everything else redirects to HTTPS.
#     location / {
#         return 301 https://$host$request_uri;
#     }
# }
