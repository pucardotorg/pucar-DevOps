# SMTP stack environment — email-smtp/.env
# Copy this file and fill in real values before running docker compose up.

# Postfix relay host (leave empty to deliver directly via MX, or set to an upstream SMTP relay)
# Example for AWS SES: RELAY_HOST=[email-smtp.us-east-1.amazonaws.com]:587
RELAY_HOST=

# SASL credentials for upstream relay (only needed if RELAY_HOST is set)
RELAY_USER=
RELAY_PASSWORD=

# Roundcube session encryption key — generate with: openssl rand -hex 24
ROUNDCUBEMAIL_DES_KEY=changeme_replace_with_24_char_hex
