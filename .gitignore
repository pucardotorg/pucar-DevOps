**/*/service_images.json
**/*.pyc

# OSX leaves these everywhere on SMB shares
._*

# OSX trash
.DS_Store

# Files generated by JetBrains IDEs, e.g. IntelliJ IDEA
.idea/
*.iml

# Vscode files
.vscode

# Emacs save files
*~
\#*\#
.\#*

# Vim-related files
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Chart dependencies
**/charts/*.tgz
*Chart.lock

.history
*.terraform
*.tfstate*
*plan.out*

# Ignore all zip files
*.tgz*

# Generated/backed-up TLS certs and private keys (see scripts/generate-acme-cert.*
# and scripts/update-route-cert.*) - never commit these
scripts/certs/
certs-backup/
*.pem
*.crt
*.key